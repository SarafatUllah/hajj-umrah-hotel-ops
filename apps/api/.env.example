# Copy to .env for local development (`cp .env.example .env`). Validated by server/utils/env.ts:
# an invalid value is a configuration error, never a silent default. No real secrets belong in this file.
# Deployment requirements: docs/DEPLOY_CHECKLIST.md. Tests use .env.test (test-only values) instead.

# Environment: development | demo | staging | production (default development).
APP_ENV=development

# PostgreSQL 16 connection string (required). The local docker compose service listens on port 5433.
# The database must have (or the migrating role must be able to create) the btree_gist extension.
DATABASE_URL=postgres://hajj_umrah:hajj_umrah_dev_password@localhost:5433/hajj_umrah_dev
# Connection-pool size per server process, 1-50 (default 10).
DATABASE_POOL_MAX=10

# Seals the session cookie (nuxt-auth-utils). Required, at least 32 characters; use a long random secret
# (e.g. `openssl rand -base64 48`) and a different one per environment. Changing it signs every user out.
NUXT_SESSION_PASSWORD=change-this-to-a-random-32-plus-character-secret
# Session cookie `Secure` flag. Unset = true (nuxt.config.ts). false ONLY for plain-http local development and
# tests (Node test clients cannot send a Secure cookie over http). MUST be true in every real deployment.
NUXT_SESSION_COOKIE_SECURE=false

# Document storage (Task 19). Only the local filesystem driver exists in Phase 1 ("local"); any other value fails
# startup. STORAGE_LOCAL_DIR (default .data/uploads, relative to the working directory) must be writable and, in a
# deployment, on PERSISTENT storage that is backed up: document metadata lives in PostgreSQL, the bytes live here.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads

# Demo organization (Task 20). The demo data and its documented password are PUBLIC by design: keep all of this OFF in
# production (and keep DEMO_SIGN_IN_ENABLED off in staging too).
# DEMO_SIGN_IN_ENABLED=true serves GET /api/public/demo-sign-in (demo login metadata incl. the demo password; it is not
# authentication). It only ever answers when APP_ENV is `development` or `demo`. With APP_ENV=production, `true` makes
# startup fail; with APP_ENV=staging the server starts but the endpoint stays closed (unknown-route 404).
# Strictly "true" or "false" (default false).
DEMO_SIGN_IN_ENABLED=false
# Demo seed/reset under APP_ENV=production is refused unless this is true. Never set it on a real production deployment.
# Strictly "true" or "false" (default false).
ALLOW_DEMO_SEED=false
# The date all time-relative demo rows (running maintenance, ended-early blocks, ...) hang off. A real YYYY-MM-DD date
# between 2000-01-01 and 2100-12-31 (default 2026-09-01).
DEMO_ANCHOR_DATE=2026-09-01

# PII encryption (Phase 2, design v7 §13). REQUIRED. Key ring "id:base64key[,id:base64key]": the first key
# encrypts, every listed key decrypts (rotate by prepending). Each key is 32 random bytes, base64
# (`openssl rand -base64 32`). PII_LOOKUP_KEY (>= 32 bytes, base64) keys the blind indexes; never reuse a key.
# In production these come from the secret manager / KMS, never from a committed file.
PII_ENCRYPTION_KEYS=k1:change-me-to-openssl-rand-base64-32
PII_LOOKUP_KEY=change-me-to-openssl-rand-base64-32

# Request security (Phase 2, design v7 §21). TRUST_PROXY=true only behind a reverse proxy that sets
# X-Forwarded-For/-Host. ALLOWED_ORIGINS: comma-separated exact origins allowed to send state-changing
# requests (the three frontends); unset = same host only. STAFF_2FA_ENFORCEMENT: off | required-roles
# (production MUST use required-roles: users holding Super Admin or Hotel Manager then enrol TOTP).
TRUST_PROXY=false
# ALLOWED_ORIGINS=https://ops.example.com,https://agency.example.com,https://www.example.com
STAFF_2FA_ENFORCEMENT=off

# Customer sign-in codes by SMS (Phase 2a, public site). disabled (default: customer sign-in answers 503) |
# log (development only: the code is written to the server log; refused in production) | webhook (POST
# {"to","text"} as JSON to SMS_WEBHOOK_URL, https only, with "Authorization: Bearer SMS_WEBHOOK_TOKEN" when set).
# log is allowed only with APP_ENV=development (the phone is masked, the code is shown).
SMS_DRIVER=disabled
# SMS_WEBHOOK_URL=https://sms-gateway.example.com/send
# SMS_WEBHOOK_TOKEN=
# Countries (calling codes) that may receive codes — the SMS-pumping guard. Default: Saudi Arabia only.
SMS_ALLOWED_CALLING_CODES=966
# SMS budget per organization (all phones together): per hour and per day; reaching it logs a warning.
SMS_HOURLY_LIMIT=300
SMS_DAILY_LIMIT=2000
# Bot check on the code request: off | turnstile (Cloudflare Turnstile; the site key goes to the public site).
CAPTCHA_DRIVER=off
# CAPTCHA_SECRET=

# Background jobs (Phase 2, pg-boss in its own `pgboss` schema). off | send | light | all (default light):
# light = the API process works every queue except CPU-heavy ones (passport OCR runs in the worker process,
# `pnpm --filter @hajj/api worker`); all = single-process deployment; send = enqueue only; off = no runtime.
JOBS_MODE=light
# Size of pg-boss's own connection pool per process (1-20, default 3), on top of DATABASE_POOL_MAX.
JOBS_POOL_MAX=3

# Optional, read by the Nitro server at runtime (not validated by env.ts): PORT (default 3000) and HOST.
# Test-only switches (never needed in .env): HTTP_TEST_SKIP_BUILD=1 makes `pnpm test:http` reuse an existing .output
# build; PERF_REPORT=1 prints timings from the integration performance tests.
