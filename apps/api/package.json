{
  "name": "@hajj/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "typecheck:types": "tsc -p tsconfig.typetests.json",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "pnpm --filter @hajj/db generate",
    "db:check": "pnpm --filter @hajj/db check",
    "db:drift": "pnpm --filter @hajj/db drift",
    "db:migrate": "pnpm --filter @hajj/db migrate",
    "db:seed": "tsx db/seed/index.ts",
    "db:test:reset": "dotenv run -f .env.test -- tsx db/scripts/resetTestDb.ts",
    "test:integration": "dotenv run -f .env.test -- pnpm --filter @hajj/db migrate && dotenv run -f .env.test -- vitest run --config vitest.integration.config.ts",
    "test:integration:fresh": "pnpm db:test:reset && pnpm test:integration",
    "test:http": "dotenv run -f .env.test -- pnpm --filter @hajj/db migrate && dotenv run -f .env.test -- vitest run --config vitest.http.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm typecheck:types && pnpm db:check && pnpm db:drift && pnpm test:unit && pnpm test:integration && pnpm test:http",
    "worker": "tsx worker/index.ts",
    "rbac:sync": "tsx db/scripts/syncRbac.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@hajj/contracts": "workspace:*",
    "@hajj/db": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "h3": "1.15.11",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "vue": "^3.5.43",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
