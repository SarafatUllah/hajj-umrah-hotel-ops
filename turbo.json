{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "build": { "dependsOn": ["^build"], "outputs": [".output/**", "dist/**"] },
    "test:unit": { "outputs": [] },
    "test:integration": { "cache": false },
    "test:http": { "cache": false }
  }
}
