{
  "name": "hajj-umrah-hotel-ops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @hajj/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:types": "pnpm --filter @hajj/api typecheck:types",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @hajj/api test:integration",
    "test:integration:fresh": "pnpm --filter @hajj/api test:integration:fresh",
    "test:http": "pnpm --filter @hajj/api test:http",
    "db:generate": "pnpm --filter @hajj/db generate",
    "db:check": "pnpm --filter @hajj/db check",
    "db:drift": "pnpm --filter @hajj/db drift",
    "db:migrate": "pnpm --filter @hajj/db migrate",
    "db:seed": "pnpm --filter @hajj/api db:seed",
    "db:test:reset": "pnpm --filter @hajj/api db:test:reset",
    "verify": "pnpm lint && pnpm typecheck && pnpm typecheck:types && pnpm db:check && pnpm db:drift && pnpm test:unit && pnpm test:integration && pnpm test:http",
    "rbac:sync": "pnpm --filter @hajj/api rbac:sync"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
