{
  "name": "hajj-umrah-hotel-ops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "typecheck:types": "tsc -p tsconfig.typetests.json",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:drift": "tsx db/scripts/checkDrift.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed/index.ts",
    "db:test:reset": "dotenv run -f .env.test -- tsx db/scripts/resetTestDb.ts",
    "test:integration": "dotenv run -f .env.test -- tsx db/migrate.ts && dotenv run -f .env.test -- vitest run --config vitest.integration.config.ts",
    "test:integration:fresh": "pnpm db:test:reset && pnpm test:integration"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "postgres": "^3.4.9",
    "vue": "^3.5.43",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
