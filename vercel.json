{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nuxtjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build"
    },
    "site": {
      "root": "apps/public-site",
      "framework": "nuxtjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "NUXT_API_PROXY_TARGET" }]
    },
    "agency": {
      "root": "apps/agency-portal",
      "framework": "nuxtjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "NUXT_API_PROXY_TARGET" }]
    },
    "ops": {
      "root": "apps/ops-console",
      "framework": "nuxtjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "NUXT_API_PROXY_TARGET" }]
    }
  },
  "rewrites": [
    { "source": "/api/jobs/tick", "destination": { "service": "api" } },
    { "source": "/(.*)", "has": [{ "type": "host", "value": { "pre": "agency." } }], "destination": { "service": "agency" } },
    { "source": "/(.*)", "has": [{ "type": "host", "value": { "pre": "agency-" } }], "destination": { "service": "agency" } },
    { "source": "/(.*)", "has": [{ "type": "host", "value": { "pre": "ops." } }], "destination": { "service": "ops" } },
    { "source": "/(.*)", "has": [{ "type": "host", "value": { "pre": "ops-" } }], "destination": { "service": "ops" } },
    { "source": "/(.*)", "destination": { "service": "site" } }
  ]
}
