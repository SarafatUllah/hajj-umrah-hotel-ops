APP_ENV=development
DATABASE_URL=postgres://hajj_umrah:hajj_umrah_dev_password@localhost:5433/hajj_umrah_dev
DATABASE_POOL_MAX=10
NUXT_SESSION_PASSWORD=change-this-to-a-random-32-plus-character-secret
# Node test clients (and plain local http dev) cannot send a Secure cookie — set to true in real deployments.
NUXT_SESSION_COOKIE_SECURE=false

# Document storage (Task 19). Only the local filesystem driver exists in Phase 1; an unsupported driver fails startup.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads

# Demo organization (Task 20). The demo data and its documented password are PUBLIC by design: keep all of this OFF in production.
# DEMO_SIGN_IN_ENABLED=true serves GET /api/public/demo-sign-in (demo credentials). It only ever works when APP_ENV is
# `development` or `demo`. With APP_ENV=production, `true` makes startup fail; with APP_ENV=staging the server starts but the
# endpoint stays closed (unknown-route 404). Leave it false everywhere else.
DEMO_SIGN_IN_ENABLED=false
# Demo seed/reset under APP_ENV=production is refused unless this is true. Never set it on a real production deployment.
ALLOW_DEMO_SEED=false
# The date all time-relative demo rows (running maintenance, ended-early blocks, ...) hang off. Must be a real YYYY-MM-DD date.
DEMO_ANCHOR_DATE=2026-09-01
